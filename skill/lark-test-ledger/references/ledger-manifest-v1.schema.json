{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lark-test-ledger:v1",
  "title": "Lark Test Ledger Manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product",
    "version",
    "meegle_feature",
    "default_environment",
    "source_documents",
    "requirements",
    "test_cases",
    "generation"
  ],
  "properties": {
    "schema_version": {
      "enum": ["lark-test-ledger/v1", "dms-test-ledger/v1"]
    },
    "product": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "meegle_feature": { "type": "string", "minLength": 1 },
    "build": { "type": "string" },
    "default_environment": { "type": "string", "minLength": 1 },
    "source_documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path", "sha256"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirement_id",
          "module",
          "title",
          "acceptance_criteria",
          "source_locator",
          "needs_clarification"
        ],
        "properties": {
          "requirement_id": { "type": "string", "minLength": 1 },
          "module": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "source_locator": { "type": "string", "minLength": 1 },
          "needs_clarification": { "type": "boolean" }
        }
      }
    },
    "test_cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "requirement_ids",
          "module",
          "title",
          "preconditions",
          "steps",
          "priority",
          "smoke_order",
          "developer_open_ids",
          "tester_open_ids"
        ],
        "properties": {
          "case_id": { "type": "string", "minLength": 1 },
          "requirement_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "module": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "preconditions": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["action", "expected"],
              "properties": {
                "action": { "type": "string", "minLength": 1 },
                "expected": { "type": "string", "minLength": 1 }
              }
            }
          },
          "priority": { "enum": ["P0", "P1", "P2", "P3"] },
          "smoke_order": {
            "oneOf": [
              { "type": "integer", "minimum": 1 },
              { "type": "null" }
            ]
          },
          "developer_open_ids": {
            "type": "array",
            "items": { "type": "string", "pattern": "^ou_[A-Za-z0-9_-]+$" }
          },
          "tester_open_ids": {
            "type": "array",
            "items": { "type": "string", "pattern": "^ou_[A-Za-z0-9_-]+$" }
          }
        }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batch_id", "generator", "generated_at", "rules_version"],
      "properties": {
        "batch_id": { "type": "string", "minLength": 1 },
        "generator": { "type": "string", "minLength": 1 },
        "generated_at": { "type": "string", "format": "date-time" },
        "rules_version": { "type": "string", "minLength": 1 }
      }
    }
  }
}
